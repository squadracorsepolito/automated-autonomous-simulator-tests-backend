from pathlib import Path

from rosbags.rosbag1 import Reader as Rosbag1Reader

value = 50
output_path = Path(f"C:/Users/aless/Desktop/automated-tests-backend/media/rosbags/test_{value}/output_rosbag_{value}.bag")
# path = 'output_rosbag1.bag'

with Rosbag1Reader(output_path) as reader:
    print(f"File aperto: {output_path}")
    print(f"Numero connessioni: {len(reader.connections)}")
    print(f"Numero messaggi: {reader.message_count}")

    # Leggiamo e stampiamo i primi 5 messaggi
    count = 0
    for connection, timestamp, data in reader.messages():
        print(f"Topic: {connection.topic}, Timestamp: {timestamp}")
        count += 1
        if count >= 5:
            break
    print(f"Messaggi rosbag2 letti: {count}")